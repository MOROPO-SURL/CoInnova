@model MOROPO.UIC.CoInnova.Models.View.PersonCollaboratorInputViewModel

<div class="modal fade" id="create-dialog" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="create-dialog-title">Agregar Colaborador (Individual)</h5>
            </div>
            @if (Model.AvailableUsers.Length <= 0)
            {
                <div class="modal-body">
                    <div class="text-muted">No existen usuarios disponibles para agregar como colaboradores individuales.</div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                </div>                
            }
            else
            {
                @using (Html.BeginForm("create", "personcollaborators", null, FormMethod.Post, true, null))
                {
                    <div class="modal-body">
                        <div>
                            @Html.LabelFor(model => model.UserId, new { @class = "control-label" })
                            @Html.DropDownListFor(model => model.UserId, Model.AvailableUsers, new { @class = "form-control"})
                            @Html.ValidationMessageFor(model => model.UserId, null, new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Agregar</button>
                        <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                    </div>
                }
            }
        </div>
    </div>
</div>
