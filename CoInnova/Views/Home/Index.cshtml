@model MOROPO.UIC.CoInnova.Models.View.HomeViewModel

@{
    ViewData["Title"] = GlobalViewLocalizationHelper.Localize("Home", ViewLocalizer);

    Layout = "_FrontendLayout";
}

@section styles{
    <style type="text/css">
        .hero-image {
            background-image: linear-gradient(90deg, rgba(240, 240, 240) 7%, rgba(240, 240, 240, 0.8) 35%, rgba(240, 240, 240, 0) 60%), url("/img/joven-empresario.jpg");
            background-repeat: no-repeat;
            background-size: cover;
            height: calc(100vh - 56px);
        }

        .push-image{
            height: 100%;
            background: #f0f0f0;
            margin-right: -17px;
            z-index: 10;
            position: inherit;
        }
        .caption-hero{
            position: absolute;
            z-index: 12;
            width: 100%;
            top: 50%;
            transform: translateY(-50%);
        }

        .hero-title {
            font-size: 4.5rem;
            font-weight: 800;
            margin-bottom: 30px;
        }

        .subtitle{
            line-height: 30px;
            font-weight: 600;
        }
        #hero-button{
            margin-top: 40px;
            display: inline-block;
        }

        #hero-button a{
            text-transform: uppercase;
            border: 0;
            color: white;
            padding: 15px;
            font-weight: 500;
            cursor: pointer;
            z-index:30;
        }
        #hero-button a:hover{
            color: black;
        }

        .button-container{
            display: grid;
            position: relative;
            background: white;
        }

        .button-container:hover div{
            width: 0;
            transition: width 0.6s;
            transform-origin: 0 0;
            transition-timing-function: cubic-bezier(0.5, 1.6, 0.4, 0.7);
        }

        .button-background{
            position: absolute;
            top: 0;
            bottom: 0;
            right: 0;
            width: 100%;
            background: rgb(250, 0, 0);
            transition: width 0.6s;
            transform-origin: 0 0;
            transition-timing-function: cubic-bezier(0.5, 1.6, 0.4, 0.7);
        }

        .innovation-container{
            padding-top: 150px;
            padding-bottom: 150px;
        }

        .card{
            border-radius: 0;
            border: none;
            text-align: center;
            padding: 35px 1.25rem;
            height: 100%;
                transition: all 0.4s ease-out 0s;
        }

        .innovation-container h2{
            font-size: 60px;
            margin-bottom: 45px;
        }

        .card-icon{
            color: #FE2147;
            transition: all 0.4s ease-out 0s;
        }

        .card-title{
            font-weight: 600;
            font-size: 25px;
            margin-top: 20px;
            margin-bottom: 20px;
            display: block;
            cursor: pointer;
        }

        .card-background{
            position: absolute;
            bottom: 8px;
            right: 12px;
            left: 10px;
            height: 0;
            background: #FE2147;
            transition: all 0.4s ease-out 0s;
        }

        .card:hover{
           transition: all 0.4s ease-out 0s;
           height: 98%;
        }

        .card:hover .card-background{
            height: 95%;
            transition: all 0.4s ease-out 0s;
        }

        .card-body{
            z-index: 2;
            transition: all 0.4s ease-out 0s;
        }

        .card:hover .card-body{
            color: white;
            padding-top: 10px;
            transition: all 0.4s ease-out 0s;
        }
        
        .card:hover .card-icon{
            color: white;
            transition: all 0.4s ease-out 0s;
        }

        .h-98{
            height: 372px;
        }

    </style>
}

<div class="">
    <div class="row" style="background: #f0f0f0;">
        <div class="caption-hero">
            <div class="container">
                <div class="row">
                    <div class="col-xl-8 col-lg-7 col-md-8">
                        <h1 class="hero-title">Union de informaticos de Cuba</h1>
                        <div class="row">
                            <div class="col-xl-8 col-lg-9 col-md-8">
                                <p class="subtitle">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                            </div>
                        </div>
                        <div id="hero-button">
                            <div class="button-container">
                                <div class="button-background"></div>
                                <a>servicios</a>
                            </div>
                            
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
            <div class="col-md-4">
            <div class="push-image">

            </div>
        </div>
        <div class="col-md-8 hero-image"></div>
    </div>
        <div class="row innovation-container" style="background: #f7f7f7;">
        <div class="container">
            <h2>Innovación</h2>
            <div class="row justify-content-md-center">
                    <div class="col-md-4 h-98">
