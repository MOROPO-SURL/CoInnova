                            <a class="card-title">Ideas Innovadoras</a>
                            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                        </div>
                        <div class="card-background"></div>
                    </div>
                </div>
                    <div class="col-md-4 h-98">
                    <div class="card">
                        <div class="card-body">
                            <a class="card-title">Retos de Innovación</a>
                            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                        </div>
                        <div class="card-background"></div>
                    </div>
                </div>
                <div class="col-md-4 h-98">
                    <div class="card">
                        <div class="card-body">
                           <a class="card-title">Prototipos</a>
                           <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                        </div>
                        <div class="card-background"></div>
                    </div>
