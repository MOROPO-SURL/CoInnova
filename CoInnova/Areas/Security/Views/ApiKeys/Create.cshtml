@model MOROPO.UIC.CoInnova.Models.View.ApiKeyInputViewModel

@{
    ViewData["Title"] = "Agregar Llave API";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("index", "dashboard", new { Area = string.Empty })
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Llaves API",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link href="~/lib/gijgo/combined/css/gijgo.css" rel="stylesheet" type="text/css" />
}

@section scripts {
    <script src="~/lib/gijgo/combined/js/gijgo.js" type="text/javascript"></script>
    <script src="~/js/crypto/sha256.js" type="text/javascript"></script>

    <script type="text/javascript">
        $(document).ready(function() {
            $('#ExpirateAt').datepicker({
                uiLibrary: 'bootstrap4',
                modal: true,
                header: true,
                footer: true,
                format: 'dd/mm/yyyy',
                value: '@Model.ExpirateAt.ToShortDateString()'
            });

            $('#token-generate-button').click(generateToken);

            generateToken();
        });

        function generateToken() {
            var id = "@System.Guid.NewGuid()";

            var now = new Date();
            
            var ticks = now.getTime();
            
            $("#Token").val(Sha256.hash(id + ticks));
        }
    </script>
}

@using (Html.BeginForm("create", "apikeys", new { Area = "security" }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    <div class="card mb-3">
        <div class="card-header"><h4 class="mb-0">@ViewData["Title"]</h4></div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.Enabled) @Html.DisplayNameFor(model => model.Enabled)
                            @Html.ValidationMessageFor(model => model.Enabled)
                        </label>
                    </div>
                </div>
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.Token, new { @class = "control-label" })
                <div class="input-group">
                    @Html.TextBoxFor(model => model.Token, new { @class = "form-control", @readonly = "readonly" })
                    <div class="input-group-append">
                        <button class="btn btn-outline-dark" type="button" id="token-generate-button"><span class="mdi mdi-settings-outline"></span> Generar</button>
                    </div>
                </div>
                @Html.ValidationMessageFor(model => model.Token, null, new { @class = "text-danger" })
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.ExpirateAt, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.ExpirateAt, new { @class = "form-control", @readonly = "readonly" })
                    @Html.ValidationMessageFor(model => model.ExpirateAt, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Host, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Host, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Host, null, new { @class = "text-danger" })
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header"><h5 class="mb-0">@Html.DisplayNameFor(model => model.UngroupedSelectablePermissions)</h5></div>

                <div class="card-body">
                    @if (Model.GroupedSelectablePermissions.Length > 0 || Model.UngroupedSelectablePermissions.Length > 0)
                    {
                        var index = 0;

                        <div class="row">
                            @foreach (var item in Model.UngroupedSelectablePermissions)
                            {
                                <div class="col-md-6">
                                    @Html.EditorFor(model => item, "SelectionDescriptedIntIDItemInputViewModel", string.Format("UngroupedSelectablePermissions[{0}]", index++))
                                </div>
                            }
                        </div>

                        foreach (var group in Model.GroupedSelectablePermissions)
                        {
                            <fieldset>
                                <legend class="border-bottom">@GlobalViewLocalizationHelper.Localize(group.Key)</legend>
                                <div class="row">
                                    @foreach (var item in group.Value)
                                    {
                                        <div class="col-md-6">
                                            @Html.EditorFor(model => item, "SelectionDescriptedIntIDItemInputViewModel", string.Format("UngroupedSelectablePermissions[{0}]", index++))
                                        </div>
                                    }
                                </div>
                            </fieldset>
                        }
                    }
                    else
                    {
                        <div>Sin elementos que mostrar.</div>
                    }
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Agregar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Cancelar</a>
        </div>
    </div>
}