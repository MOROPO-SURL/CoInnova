@model MOROPO.UIC.CoInnova.Models.View.IdeaWorkflowInputViewModel

@{
    ViewData["Title"] = "Agregar Modelo de Gestión de Ideas";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("index", "dashboard", new { Area = string.Empty })
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Modelos de Gestión de Ideas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("create", "ideaworkflows", new { Area = "auxiliars" }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    <div class="card mb-3">
        <div class="card-header"><h4 class="mb-0">@ViewData["Title"]</h4></div>

        <div class="card-body">
            <div class="row">
                <div class="col mb-3">
                    @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="mb-4">
                @Html.LabelFor(model => model.Description, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Description, 4, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Description, null, new { @class = "text-danger" })
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="card-title h4">Etapa Inicial</div>
                    <div class="row">
                        <div class="col mb-3">
                            @Html.LabelFor(model => model.StartStepName, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.StartStepName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.StartStepName, null, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div>
                        @Html.LabelFor(model => model.StartStepDescription, new { @class = "control-label" })
                        @Html.TextAreaFor(model => model.StartStepDescription, 4, 0, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.StartStepDescription, null, new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Agregar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Cancelar</a>
        </div>
    </div>
}