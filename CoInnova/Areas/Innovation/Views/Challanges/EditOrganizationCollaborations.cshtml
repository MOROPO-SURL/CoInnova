@model MOROPO.UIC.CoInnova.Models.View.ChallangeCollaboratorsViewModel

@{
    ViewData["Title"] = "Modificar Reto de Innovación (Organizaciones Colaboradoras)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Retos de Innovación",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link rel="stylesheet" href="~/lib/bootstrap-combobox/css/bootstrap-combobox.css" />
    <style type="text/css">
        .dropdown-toggle {
            border-radius: 0.25rem;
            border: 1px solid #ced4da;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            margin-left: -1px;
            line-height: 36px;
        }

        .dropdown-toggle::after {
            margin: 0 5px;
        }

        ul.dropdown-menu{
            width: 100%;
        }
    </style>
}

@section scripts {
    <script src="~/lib/bootstrap-combobox/js/bootstrap-combobox.js"></script>
    <script type="text/javascript">
        $('#collaboratorId').combobox();
    </script>

}

<div class="card" style="margin-bottom: 20px;">
    <div class="card-header">
        <h4>Modificar Reto de Innovación</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("edit", @Model.Challange.Id)">Generales</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active">Colaboradores</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("editdocuments", @Model.Challange.Id)">Documentos</a>
            </li>
        </ul>
    </div>
    <div class="card-body pb-2">
        <div class="alert alert-dark mb-4">
            <details>
                <summary class="h4 mb-0">@Model.Challange.Title</summary>
                <hr />
                <dl class="mb-0">
                    <dt>@Html.DisplayNameFor(model => model.Challange.Workflow)</dt>
                    @if (Model.Challange.Workflow == null)
                    {
                        <dd>---</dd>
                    }
                    else
                    {
                        <dd>@Model.Challange.Workflow.Name</dd>
                    }
                </dl>
            </details>
        </div>
        <div class="modal fade" id="add-collaborator" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="add-collaborator-title">Agregar Colaborador</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    @using (Html.BeginForm("addorganizationcollaboration", "challanges", new { key = Model.Challange.Id }, FormMethod.Post, true, null))
                    {
                        <div class="modal-body">
                            @if (Model.AvailableCollaborators.Length > 0)
                            {
                                @Html.DropDownList("collaboratorId", Model.AvailableCollaborators, "Seleccione o búsque aquí ...", new { @class = "form-control" })
                            }else{
                                <div class="text-muted font-italic mb-0">No hay otras organizaciones disponibles para agregar</div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Agregar</button>
                            <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card" style="margin-bottom: 20px;">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("editpersoncollaborations", @Model.Challange.Id)">Personas</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="#">Organizaciones</a>
                    </li>
                </ul>
            </div>
            <div class="card-body pb-0">
                @if (Model.Collaborators.Length <= 0)
                {
                    <p class="text-muted mb-3">Sin elementos que mostrar</p>
                }
                else
                {
                    <div class="row">
                        @foreach (var item in Model.Collaborators)
                        {
                            <div class="col-lg-2 col-md-3 col-sm-4" style="margin-bottom: 20px;">
                                @if (item.OrganizationIdentity.ImageId != null)
                                {
                                    <img title="@item.OrganizationIdentity.Name" class="img-thumbnail" src="~/media/images/@item.OrganizationIdentity.ImageId.@item.OrganizationIdentity.ImageExtension" />
                                }
                                else
                                {
                                    <img title="@item.OrganizationIdentity.Name" class="img-thumbnail" src="~/img/default-organization-picture.png" />
                                }
                                <div class="text-center mt-2">
                                    <div>@item.OrganizationIdentity.Name</div>
                                    <div class="mt-2">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-light" data-toggle="modal" data-target="#descrip-@item.Id"><span class="mdi mdi-file-eye-outline"></span><span>Detail</span></button>
                                            <button role="button" class="btn btn-danger" data-toggle="modal" data-target="#delete-@item.Id"><span class="mdi mdi-trash-can-outline"></span>Eliminar</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal fade" id="delete-@item.Id" tabindex="-1" role="dialog" aria-labelledby="delete-@item.Id-lable" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            @using (Html.BeginForm("deleteorganizationcollaboration", "challanges", new { key = Model.Challange.Id }, FormMethod.Post, true, new { @class = "modal-content" }))
                                            {
                                                @Html.Hidden("collaboratorId", item.Id)

                                                <div class="modal-header">
                                                    <h4 class="modal-title" id="delete-@item.Id-lable">Eliminar Colaborador</h4>
                                                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="mb-0">Esta seguro que desea eliminar el colaborador seleccionado?</p>
                                                </div>
                                                <div class="modal-footer" style="margin-top: 0;">
                                                    <button type="submit" class="btn btn-danger">Eliminar</button>
                                                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="card-footer">
        <a class="btn btn-primary" href="#" data-toggle="modal" data-target="#add-collaborator">Agregar</a>
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>
</div>


