@model MOROPO.UIC.CoInnova.Models.View.OrganizationCollaboratorInputViewModel

@{
    ViewData["Title"] = "Modificar Colaborador (Organización)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("index", "dashboard", new { Area = string.Empty })
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Colaboradores",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link href="~/lib/gijgo/combined/css/gijgo.css" rel="stylesheet" type="text/css" />

    <style type="text/css">
        #ImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }
    </style>
}

@section scripts {
    <script src="~/lib/gijgo/combined/js/gijgo.js" type="text/javascript"></script>

    <script type="text/javascript">
        $(document).ready(function() {
            $('#BornDate').datepicker({
                uiLibrary: 'bootstrap4',
                modal: true,
                header: true,
                footer: true,
                format: 'dd/mm/yyyy',
                value: @if (Model.BornDate == null) { @Html.Raw("null"); } else { @Html.Raw(string.Format("'{0}'", Model.BornDate.Value.ToShortDateString())); }
            });

            $(function() {
                $(document).on("change", "#ImageFile", function() {
                    var files = !!this.files ? this.files : [];

                    if (!files.length || !window.FileReader) return; // no file selected, or no FileReader support

                    if (/^image/.test(files[0].type)) {
                        var reader = new FileReader();

                        reader.readAsDataURL(files[0]);

                        reader.onloadend = function() {
                            $('#ImageFilePreview').attr('src', this.result);
                        }
                    }

                });
            });
        });
    </script>
}

@using (Html.BeginForm("edit", "organizationcollaborators", new { Area = "innovation", key = string.Empty }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.Id)

    <div class="card mb-3">
        <div class="card-header"><h4 class="mb-0">@ViewData["Title"]</h4></div>

        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-5">
                    <div class="card mb-3">
                        @if (Model.ImageId == null)
                        {
                            <img src="~/img/default-organization-picture.png" class="card-img-top" id="ImageFilePreview" />
                        }
                        else
                        {
                            var imageSource = string.Format("/media/images/{0}.{1}", Model.ImageId, Model.ImageExtension);

                            <img src="@imageSource" class="card-img-top" id="ImageFilePreview" />
                        }                        
                        <label class="btn btn-light" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-bottom: 0;">
                            @GlobalViewLocalizationHelper.Localize("Upload", ViewLocalizer) ...
                            @Html.EditorFor(model => model.ImageFile)
                        </label>
                    </div>
                    @Html.ValidationMessageFor(model => model.ImageFile, null, new { @class = "text-danger" })
                </div>
                <div class="col-lg-9 col-md-8 col-sm-7">
                    <div class="mb-3">
                        @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.Alias, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.Alias, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Alias, null, new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(model => model.BornDate, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.BornDate, new { @class = "form-control", @readonly = "readonly" })
                            @Html.ValidationMessageFor(model => model.BornDate, null, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.UserId, new { @class = "control-label" })
                            @Html.DropDownListFor(model => model.UserId, Model.AvailableUsers, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.UserId, null, new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
            <div>
                @Html.LabelFor(model => model.About, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.About, 6, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.About, null, new { @class = "text-danger" })
            </div>       
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}