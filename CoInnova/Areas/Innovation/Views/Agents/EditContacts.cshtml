@model MOROPO.UIC.CoInnova.Models.View.InnovationAgentContactsViewModel

@{
    ViewData["Title"] = "Modificar Agente de Innovación (Contactos)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Agentes de Innovación",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <style type="text/css">
        #ImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }
    </style>
}

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4>Modificar Agente de Innovación</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("edit", @Model.Agent.Id)">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="#">Contactos</a>
                </li>
            </ul>
        </div>
        
        <div class="card-body">
            <div class="alert alert-dark mb-4">
                <details>
                    <summary class="h4 mb-0">@Model.Agent.Identity.Name</summary>
                    <hr />
                    <div class="row">
                        <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
                            @if (Model.Agent.Identity.ImageId != null)
                            {
                                <img class="img-thumbnail" src="~/media/images/@Model.Agent.Identity.ImageId.@Model.Agent.Identity.ImageExtension" />
                            }
                            else
                            {
                                <img class="img-thumbnail" src="~/img/default-organization-picture.png" />
                            }
                        </div>
                        <div class="col-lg-10 col-md-8 col-sm-6">
                            <dl>
                                <dt>Fecha de Creación</dt>
                                @if (Model.Agent.Identity.BornDate == null)
                                {
                                    <dd>--</dd>
                                }
                                else
                                {
                                    <dd>@Model.Agent.Identity.BornDate.Value.ToShortDateString()</dd>
                                }
                            </dl>
                        </div>
                    </div>
                </details>
            </div>
            <div class="row">
                <div class="col-md-6" style="margin-bottom: 20px;">
                    <div class="page-header">
                        <h4>Teléfonos<a class="btn btn-primary btn-sm float-right" href="#" data-toggle="modal" data-target="#add-phonecontact"><span class="mdi mdi-plus"></span> Agregar</a></h4>
                    </div>

                    @await Html.PartialAsync("EditContactsAddPhonePartial", new MOROPO.UIC.CoInnova.Models.View.PhoneContactInputViewModel { OwnerId = Model.Agent.Id })
                    
                    <table class="table" style="margin: 0;">
                        <thead>
                            <tr>
                                <th>@GlobalViewLocalizationHelper.Localize("Number")</th>
                                <th>@GlobalViewLocalizationHelper.Localize("Label")</th>
                                <th style="width: 1px; white-space: nowrap;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PhoneContacts.Count > 0)
                            {
                                @foreach (var item in Model.PhoneContacts)
                                {
                                    <tr>
                                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Number")">@item.Number</td>
                                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Label")">@item.Label</td>
                                        <td style="vertical-align: middle;">
                                            <a role="button" href="#" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#delete-phonecontact-@item.Id">Eliminar</a>
                                            <div class="modal fade" id="delete-phonecontact-@item.Id" tabindex="-1" role="dialog" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="delete-phonecontact-@item.Id-title">Eliminar Contacto telefónico</h5>
                                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                <span aria-hidden="true">&times;</span>
                                                            </button>
                                                        </div>
                                                        @using (Html.BeginForm("EditContactsPhoneDelete", "agents", new { key = Model.Agent.Id }, FormMethod.Post, true, null))
                                                        {
                                                            @Html.Hidden("itemId", item.Id)

                                                            <div class="modal-body">
                                                                <p class="mb-0">Está seguro que desea eliminar el contacto telefónico con la etiqueta <b>@item.Label</b> y número <b>@item.Number</b>?</p>
                                                            </div>

                                                            <div class="modal-footer" style="margin-top: 0;">
                                                                <button type="submit" class="btn btn-danger">Eliminar</button>
                                                                <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6" style="margin-bottom: 20px;">
                    <div class="page-header">
                        <h4>Correos Electrónicos<a class="btn btn-primary btn-sm float-right" href="#" data-toggle="modal" data-target="#add-nautacontact"><span class="mdi mdi-plus"></span> Agregar</a></h4>
                    </div>
                    @await Html.PartialAsync("EditContactsAddEmailPartial", new MOROPO.UIC.CoInnova.Models.View.EmailContactInputViewModel { OwnerId = Model.Agent.Id })
                    <table class="table" style="margin: 0;">
                        <thead>
                            <tr>
                                <th>@GlobalViewLocalizationHelper.Localize("Email")</th>
                                <th>@GlobalViewLocalizationHelper.Localize("Label")</th>
                                <th style="width: 1px; white-space: nowrap;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.EmailContacts.Count > 0)
                            {
                                @foreach (var item in Model.EmailContacts)
                                {
                                    <tr>
                                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Email")">@item.Address</td>
                                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Label")">@item.Label</td>
                                        <td style="vertical-align: middle;">
                                            <a role="button" href="#" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#delete-emailcontact-@item.Id">Eliminar</a>
                                            <div class="modal fade" id="delete-emailcontact-@item.Id" tabindex="-1" role="dialog" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="delete-emailcontact-@item.Id-title">Eliminar Contacto de Correo Electrónico</h5>
                                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                <span aria-hidden="true">&times;</span>
                                                            </button>
                                                        </div>
                                                        @using (Html.BeginForm("EditContactsEmailDelete", "agents", new { key = Model.Agent.Id }, FormMethod.Post, true, null))
                                                        {
                                                            @Html.Hidden("itemId", item.Id)

                                                            <div class="modal-body">
                                                                <p class="mb-0">Está seguro que desea eliminar el contacto de correo electrónico con la etiqueta <b>@item.Label</b> y la dirección <b>@item.Address</b>?</p>
                                                            </div>

                                                            <div class="modal-footer" style="margin-top: 0;">
                                                                <button type="submit" class="btn btn-danger">Eliminar</button>
                                                                <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            
        </div>
    <div class="card-footer">
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>
    </div>
     

