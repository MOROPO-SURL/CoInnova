@model MOROPO.UIC.CoInnova.Models.View.InnovationAgentModeratorsViewModel

@{
    ViewData["Title"] = "Modificar Agente de Innovación (Moderadores)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Agentes de Innovación",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link rel="stylesheet" href="~/lib/bootstrap-combobox/css/bootstrap-combobox.css" />
    <style type="text/css">
        .dropdown-toggle {
            border-radius: 0.25rem;
            border: 1px solid #ced4da;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            margin-left: -1px;
            line-height: 36px;
        }

        .dropdown-toggle::after {
            margin: 0 5px;
        }

        ul.dropdown-menu{
            width: 100%;
        }
    </style>
}

@section scripts {
    <script src="~/lib/bootstrap-combobox/js/bootstrap-combobox.js"></script>
    <script type="text/javascript">
        $('#userId.form-control').combobox();
    </script>
}

<div class="card" style="margin-bottom: 20px;">
    <div class="card-header">
        <h4>Modificar Agente de Innovación</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Edit", @Model.Agent.Id)">Generales</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("EditContacts", @Model.Agent.Id)">Contactos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">Moderadores</a>
            </li>
        </ul>
    </div>
    <div class="card-body pb-2">
        <div class="alert alert-dark mb-4">
            <details>
                <summary class="h4 mb-0">@Model.Agent.Identity.Name</summary>
                <hr />
                <div class="row">
                    <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
                        @if (Model.Agent.Identity.ImageId != null)
                        {
                            <img class="img-thumbnail" src="~/media/images/@Model.Agent.Identity.ImageId.@Model.Agent.Identity.ImageExtension" />
                        }
                        else
                        {
                            <img class="img-thumbnail" src="~/img/default-organization-picture.png" />
                        }
                    </div>
                    <div class="col-lg-10 col-md-8 col-sm-6">
                        <dl>
                            <dt>Fecha de Creación</dt>
                            @if (Model.Agent.Identity.BornDate == null)
                            {
                                <dd>--</dd>
                            }
                            else
                            {
                                <dd>@Model.Agent.Identity.BornDate.Value.ToShortDateString()</dd>
                            }
                        </dl>
                    </div>
                </div>
            </details>
        </div>
        <div class="modal fade" id="add-user" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="add-user-title">Agregar Moderador</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    @using (Html.BeginForm("EditModeratorsAdd", "agents", new { key = Model.Agent.Id }, FormMethod.Post, true, null))
                    {
                        <div class="modal-body">
                            @if (Model.AvailableUserSeletListItems.Length > 0)
                            {
                                @Html.DropDownList("userId", Model.AvailableUserSeletListItems, "Seleccione o búsque aquí ...", new { @class = "form-control" })
                            }else{
                                <div class="text-muted font-italic mb-0">No hay otros usuarios disponibles para agregar</div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Agregar</button>
                            <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (Model.Moderators.Length <= 0)
        {
            <p class="text-muted mb-3">Sin elementos que mostrar</p>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model.Moderators)
                {
                    <div class="col-lg-2 col-md-3 col-sm-4" style="margin-bottom: 20px;">
                        @if (item.ImageId != null)
                        {
                            <img title="@item.Id" class="img-thumbnail rounded-circle" src="~/media/images/@item.ImageId.@item.ImageExtension" />
                        }
                        else
                        {
                            <img title="@item.Id" class="img-thumbnail rounded-circle" src="~/img/default-person-picture.jpg" />
                        }
                        <div class="text-center mt-2">
                            <i><b>@item.Id</b></i>
                            <div>@item.Name</div>
                            @if (!string.IsNullOrEmpty(item.LastName))
                            {
                                <div>@item.LastName</div>
                            }
                            <div class="mt-2">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-light" data-toggle="modal" data-target="#descrip-@item.Id"><span class="mdi mdi-file-eye-outline"></span><span>Detalles</span></button>
                                    <button role="button" class="btn btn-danger" data-toggle="modal" data-target="#delete-@item.Id"><span class="mdi mdi-trash-can-outline"></span>Eliminar</button>
                                </div>
                            </div>
                        </div>
                        <div class="modal fade" id="delete-@item.Id" tabindex="-1" role="dialog" aria-labelledby="delete-@item.Id-lable" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    @using (Html.BeginForm("EditModeratorsDelete", "agents", new { key = Model.Agent.Id }, FormMethod.Post, true, new { @class = "modal-content" }))
                                    {
                                        @Html.Hidden("userId", item.Id)

                                        <div class="modal-header">
                                            <h4 class="modal-title" id="delete-@item.Id-lable">Eliminar Moderador</h4>
                                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                        </div>
                                        <div class="modal-body">
                                            <p class="mb-0">Esta seguro que desea eliminar el moderador seleccionado?</p>
                                        </div>
                                        <div class="modal-footer" style="margin-top: 0;">
                                            <button type="submit" class="btn btn-danger">Eliminar</button>
                                            <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    <div class="card-footer">
        <a class="btn btn-primary" href="#" data-toggle="modal" data-target="#add-user">Agregar</a>
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>
</div>


