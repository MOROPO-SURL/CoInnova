@model MOROPO.UIC.CoInnova.Models.View.PrototypeCollaboratorsViewModel

@{
    ViewData["Title"] = "Modificar Prototipo (Participantes)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Prototipos",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<div class="card" style="margin-bottom: 20px;">
    <div class="card-header">
        <h4>Modificar Prototipo</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("edit", @Model.Prototype.Id)">Generales</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active">Participantes</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("editimages", @Model.Prototype.Id)">Imágenes</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("editdocuments", @Model.Prototype.Id)">Documentos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("editspheses", @Model.Prototype.Id)">Esferas de Acción</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("editusecases", @Model.Prototype.Id)">Escalamientos</a>
            </li>
        </ul>
    </div>
    <div class="card-body pb-2">
        <div class="alert alert-dark mb-4">
            <details>
                <summary class="h4 mb-0">@Model.Prototype.Title</summary>
                <hr />
                <div class="row">
                    <dl class="col-md-6 mb-3">
                        <dt>@Html.DisplayNameFor(model => model.Prototype.Level)</dt>
                        <dd>@Model.Prototype.Level.Name</dd>
                    </dl>
                    <dl class="col-md-6 mb-3">
                        <dt>@Html.DisplayNameFor(model => model.Prototype.InnovationAgent.OrganizationIdentity.Name)</dt>
                        <dd>@Model.Prototype.InnovationAgent.OrganizationIdentity.Name</dd>
                    </dl>
                </div>
                <dl class="mb-0">
                    <dt>@Html.DisplayNameFor(model => model.Prototype.Idea)</dt>
                    @if (Model.Prototype.Idea == null)
                    {
                        <dd>---</dd>
                    }
                    else
                    {
                        <dd>@Model.Prototype.Idea.Title</dd>
                    }
                </dl>
            </details>
        </div>
        <div class="modal fade" id="add-collaborator" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="add-collaborator-title">Agregar Participante</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    @using (Html.BeginForm("addcollaborator", "prototypes", new { key = Model.Prototype.Id }, FormMethod.Post, true, null))
                    {
                        <div class="modal-body">
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Agregar</button>
                            <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                        </div>
                    }
                </div>
            </div>
        </div>
        @if (Model.Collaborators.Length <= 0)
        {
            <p class="text-muted mb-2">Sin elementos que mostrar</p>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model.Collaborators)
                {
                    <div class="col-lg-3 col-md-6">
                        @if (item.OrganizationIdentity != null)
                        {
                            <h5>@item.OrganizationIdentity.Name</h5>
                        }
                        else
                        {
                            <h5>@item.User.Name @item.User.LastName</h5>
                        }
                    </div>
                }
            </div>
        }
    </div>
    <div class="card-footer">
        <a class="btn btn-primary" href="#" data-toggle="modal" data-target="#add-collaborator">Agregar</a>
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>
</div>


