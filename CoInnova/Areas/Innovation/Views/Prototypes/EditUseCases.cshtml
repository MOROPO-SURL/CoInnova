@model MOROPO.UIC.CoInnova.Models.View.PrototypeUseCasesViewModel

@{
    ViewData["Title"] = "Modificar Prototipo (Escalamientos)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Prototipos",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<div class="card" style="margin-bottom: 20px;">
    <div class="card-header">
        <h4>Modificar Prototipo</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("edit", @Model.Prototype.Id)">Generales</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("editexecutors", @Model.Prototype.Id)">Ejecutores</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("editdocuments", @Model.Prototype.Id)">Documentos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("editimages", @Model.Prototype.Id)">Imágenes</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("editspheres", @Model.Prototype.Id)">Esferas de Acción</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active">Escalamientos</a>
            </li>
        </ul>
    </div>
    <div class="card-body pb-0">
        <div class="alert alert-dark mb-4">
            <details>
                <summary class="h4 mb-0">@Model.Prototype.Title</summary>
                <hr />
                <div class="row">
                    <dl class="col-md-6 mb-3">
                        <dt>@Html.DisplayNameFor(model => model.Prototype.Level)</dt>
                        <dd>@Model.Prototype.Level.Name</dd>
                    </dl>
                    <dl class="col-md-6 mb-3">
                        <dt>@Html.DisplayNameFor(model => model.Prototype.InnovationAgent.OrganizationIdentity.Name)</dt>
                        <dd>@Model.Prototype.InnovationAgent.OrganizationIdentity.Name</dd>
                    </dl>
                </div>
                <dl class="mb-0">
                    <dt>@Html.DisplayNameFor(model => model.Prototype.Idea)</dt>
                    @if (Model.Prototype.Idea == null)
                    {
                        <dd>---</dd>
                    }
                    else
                    {
                        <dd>@Model.Prototype.Idea.Title</dd>
                    }
                </dl>
            </details>
        </div>
        @if (Model.UseCases.Length <= 0)
        {
            <p class="text-muted">Sin elementos que mostrar</p>
        }
        else
        {
            @foreach (var item in Model.UseCases)
            {
                <div class="card" style="margin-bottom: 1.25rem !important;">
                    @if (item.FeatureImageId != null)
                    {
                        var imageColClass = item.IsFeatureImageLandscape ? "col-lg-4 col-md-5 col-sm-6" : "col-lg-2 col-md-3 col-sm-4";
                        var bodyColClass = item.IsFeatureImageLandscape ? "col-lg-8 col-md-7 col-sm-6" : "col-lg-10 col-md-9 col-sm-8";

                        <div class="row no-gutters">
                            <div class="@imageColClass">
                                <img src="~/media/images/@item.FeatureImageId.@item.FeatureImageExtension" class="img-fluid" alt="">
                            </div>
                            <div class="@bodyColClass">
                                <div class="card-body">
                                    <h3 class="mb-0">@item.Collaborator.OrganizationIdentity.Name</h3>
                                    @if (item.About != null)
                                    {
                                        <p class="mt-3 mb-0">@item.About</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card-body">
                            <h3 class="mb-0">@item.Collaborator.OrganizationIdentity.Name</h3>
                            @if (item.About != null)
                            {
                                <p class="mt-3 mb-0">@item.About</p>
                            }
                        </div>
                    }
                    <div class="card-footer text-right">
                        <a role="button" href="@Url.Action("modifyusecase", new { id = item.Id })" class="btn btn-sm btn-light" title="Editar"><span class="mdi mdi-square-edit-outline"></span><span class="hidden-xs"> Modificar</span></a>
                        <a class="btn btn-sm btn-danger" href="#" data-toggle="modal" data-target="#delete-@item.Id"><span class="mdi mdi-trash-can"></span> Eliminar</a>
                    </div>
                </div>
                <div class="modal fade" id="delete-@item.Id" tabindex="-1" role="dialog" aria-labelledby="delete-@item.Id-lable" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            @using (Html.BeginForm("deleteusecase", "prototypes", new { key = Model.Prototype.Id }, FormMethod.Post, true, new { @class = "modal-content" }))
                            {
                                @Html.Hidden("id", item.Id)

                                <div class="modal-header">
                                    <h4 class="modal-title" id="delete-image-@item.Id-lable">Eliminar Escalamiento</h4>
                                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                </div>
                                <div class="modal-body">
                                    <p class="mb-0">Esta seguro que desea eliminar el escalamiento seleccionado?</p>
                                </div>
                                <div class="modal-footer" style="margin-top: 0;">
                                    <button type="submit" class="btn btn-danger">Eliminar</button>
                                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
    <div class="card-footer">
        <a class="btn btn-primary" asp-action="addusecase" asp-route-key="@Model.Prototype.Id">Agregar</a>
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>
</div>


