@model MOROPO.UIC.CoInnova.Models.View.PrototypeInputViewModel

@{
    ViewData["Title"] = "Modificar Prototipo";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("index", "dashboard", new { Area = string.Empty })
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Prototipos",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("edit", "prototypes", new { Area = "innovation", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.Id)

    <div class="card mb-3">
        <div class="card-header">
            <h4>@ViewData["Title"]</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("editexecutors", @Model.Id)">Ejecutores</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("editdocuments", @Model.Id)">Documentos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("editimages", @Model.Id)">Imágenes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("editspheres", @Model.Id)">Esferas de Acción</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("editusecases", @Model.Id)">Escalamientos</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(model => model.Title, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.Title, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Title, null, new { @class = "text-danger" })
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.InnovationAgentId, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.InnovationAgentId, Model.AvailableInnovationAgents, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.InnovationAgentId, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.LevelId, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.LevelId, Model.AvailablePrototypingLevels, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.LevelId, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="row">
                <div class="col-auto mb-3">
                    @Html.LabelFor(model => model.IsPublic, new { @class = "control-label" })
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.IsPublic)
                            @Html.ValidationMessageFor(model => model.IsPublic)
                        </label>
                    </div>
                </div>
                <div class="col mb-3">
                    @Html.LabelFor(model => model.IdeaId, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.IdeaId, Model.AvailableIdeas, GlobalViewLocalizationHelper.Localize("None"), new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.IdeaId, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.Summary, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Summary, 6, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Summary, null, new { @class = "text-danger" })
            </div>
            <div>
                @Html.LabelFor(model => model.Description, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Description, 18, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Description, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}