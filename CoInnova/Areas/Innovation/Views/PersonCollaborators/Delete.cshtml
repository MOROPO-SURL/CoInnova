@model MOROPO.UIC.CoInnova.Models.View.CollaboratorDisplayViewModel

@{
    ViewData["Title"] = "Eliminar Colaborador";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("index", "dashboard", new { Area = string.Empty })
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Colaboradores",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<h3>Esta seguro que desea eliminar el colaborador detallado a continuación?</h3>

<dl>
    <dt>@Html.DisplayNameFor(model => model.User)</dt>
    <dd>@Html.Raw(string.IsNullOrEmpty(Model.User.LastName) ? string.Format("{0} ({1})", Model.User.Name.Trim(), Model.User.Id) : string.Format("{0} {1} ({2})", Model.User.Name.Trim(), Model.User.LastName.Trim(), Model.User.Id))</dd>
</dl>
@using (Html.BeginForm("delete", "personcollaborators", new { Area = "innovation", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.HiddenFor(model => model.Id)
    <div>
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="btn btn-light" href="@Url.Action("index")">Cancelar</a>
    </div>
}
